{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/hashes.json)",
      "Write(/hashes.json)"
    ],
    "ask": [
      "Bash(agent-kit install:*)",
      "Bash(python3 -m kit install:*)",
      "Bash(python -m kit install:*)",
      "Bash(agent-kit replay:*)",
      "Bash(python3 -m kit replay:*)",
      "Bash(python -m kit replay:*)"
    ]
  }
}
